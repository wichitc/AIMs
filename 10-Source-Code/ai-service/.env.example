ENV=development
DATABASE_URL=postgresql+asyncpg://aims:aims@localhost:5432/aims

# Must match the Core API's JWT signing secret/algorithm exactly — this service
# validates tokens issued by app/core/security.py in the backend, it does not issue its own.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# Optional. If unset, the service falls back to NullLLMClient / LocalHashEmbedding
# so it still starts and is testable without network access or secrets.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
EMBEDDING_DIMENSIONS=1536
CORS_ORIGINS=http://localhost:3000
