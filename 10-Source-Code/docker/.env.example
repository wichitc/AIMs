# Copy to .env in this directory before running `docker compose up`.
# Never commit the real .env — see Deployment.md §5.

POSTGRES_USER=aims
POSTGRES_PASSWORD=aims
POSTGRES_DB=aims

# Shared between backend and ai-service — both must validate the same tokens.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8001/v1

# Creates a login-ready admin user on startup (see backend/app/seed.py). Set to "false"
# for staging/production — a well-known seeded password must never exist there.
SEED_DEMO_DATA=true
